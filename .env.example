# Core works without external model credentials. CLI does not auto-load this file.
TREND_DB=.runtime/trendcoffee.db
# Set a long random value to enable operator routes. Never commit the real secret.
TREND_STAFF_TOKEN=
# Optional semantic evidence selection. Both must be configured to enable.
OPENAI_API_KEY=
TREND_OPENAI_MODEL=

# Direct serve/MCP: 1 sends customer-confirmed orders and reads merchant QR/status.
# Managed kiosk launcher defaults to 1; set 0 for local queue only.
TREND_MERCHANT_ENABLED=0
# Direct serve/MCP: leave blank to disable printing. Managed kiosk defaults to GP-C180I.
# Requires CUPS lp/ipptool and pdftoppm; only merchant-completed official invoices print.
TREND_PRINT_QUEUE=

# Direct API: blank disables WebRTC avatar. scripts/kiosk.py enables the local engine by default.
# Prepare/start scripts/livetalking_local.py before setting this value.
TREND_AVATAR_URL=
